{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["role", "company", "requirements", "relevantSkills", "gaps", "suggestions"],
  "properties": {
    "role": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "kind", "matched", "evidence"],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "kind": {
            "enum": ["required", "preferred"]
          },
          "matched": {
            "type": "boolean"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "relevantSkills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "target", "original", "proposed", "reason", "evidenceRefs"],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": ["summary", "bullet", "skills"]
          },
          "target": {
            "type": "string"
          },
          "original": {
            "type": "string"
          },
          "proposed": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
