{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "experienceIndex",
          "canAdd",
          "proposed",
          "reason",
          "evidenceRefs",
          "missingInfo"
        ],
        "properties": {
          "experienceIndex": { "type": "integer", "minimum": 0 },
          "canAdd": { "type": "boolean" },
          "proposed": { "type": "string" },
          "reason": { "type": "string" },
          "evidenceRefs": { "type": "array", "items": { "type": "string" } },
          "missingInfo": { "type": "string" }
        }
      }
    }
  }
}
